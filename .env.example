NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NUXT_PUBLIC_REQUEST_TIMEOUT_MS=30000

# Bật true để xem UI với dữ liệu mẫu (chưa cần backend/auth)
NUXT_PUBLIC_USE_MOCK_API=true

# Firebase Web (public config từ Firebase Console)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# Vercel (Production): set trong Project → Settings → Environment Variables
# NUXT_PUBLIC_API_BASE_URL=https://<your-be>.vercel.app/api/v1
# NUXT_PUBLIC_USE_MOCK_API=false
# NUXT_PUBLIC_REQUEST_TIMEOUT_MS=30000
